# ==========================================
# BatteryGate & BatterySentry Configuration
# ==========================================

# 1. Google Gemini API Key (100% Free via https://aistudio.google.com/)
# Paste your key here, in your AWS Lambda Environment Variables, or directly in lambda_function.py
GEMINI_API_KEY=AIzaSyYourCopiedKeyHere

# 2. AWS DynamoDB Table (Default: BatteryReports)
TABLE_NAME=BatteryReports

# 3. SMTP Email Alerts (Optional - for automated certificate dispatch)
SENDER_EMAIL=
SENDER_PASSWORD=
